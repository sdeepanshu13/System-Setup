# Build output (uploaded to GitHub Releases, not committed)
dist/

# Per-run logs
Windows/logs/

# Generated files
Windows/github-ssh-pubkey.txt
Windows/git-fallback-install.log
Windows/CodeSigning.cer

# Local OTP delivery config + dev codes -- NEVER commit secrets.
# (Encrypted user profiles Shared/profiles/*.json ARE committed on purpose.)
Shared/Config/.otp-config.json
Shared/Config/.otp-dev.txt
Windows/users/

# Supabase secret / service-role keys must never be committed.
# Only Shared/Config/supabase-config.json (URL + publishable key) is tracked.
.env
.env.local
**/supabase-secret*.json

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
